{
  "users": {
    "group": "D2",
    "description": "Облікові записи; ідентичність зберігається після деактивації.",
    "fields": [
      {
        "name": "id",
        "type": "UUID",
        "required": "Так",
        "rule": "PK; UUID сервера",
        "example": "00000000-0000-4000-8000-000000000001",
        "pii": "Ні",
        "default": "Немає",
        "purpose": "Первинний ідентифікатор запису"
      },
      {
        "name": "login",
        "type": "Unicode text",
        "required": "Так",
        "rule": "1–100 кодових точок після trim",
        "example": "Навчальне значення",
        "pii": "Так",
        "default": "Немає",
        "purpose": "Нормалізований ідентифікатор входу"
      },
      {
        "name": "display_name",
        "type": "Unicode text",
        "required": "Так",
        "rule": "1–150 кодових точок після trim",
        "example": "Навчальне значення",
        "pii": "Так",
        "default": "Немає",
        "purpose": "Ім’я для відображення"
      },
      {
        "name": "credential_hash",
        "type": "opaque text",
        "required": "Так",
        "rule": "Хеш локального пароля; алгоритм і параметри визначаються в 2.3; ніколи не передається через API",
        "example": "<синтетичний хеш>",
        "pii": "Секрет",
        "default": "Немає",
        "purpose": "Перевірочний хеш пароля"
      },
      {
        "name": "active",
        "type": "boolean",
        "required": "Так",
        "rule": "true / false",
        "example": "true",
        "pii": "Ні",
        "default": "true",
        "purpose": "Чинність запису для нових операцій"
      },
      {
        "name": "version",
        "type": "integer ≥ 1",
        "required": "Так",
        "rule": "Зростає при кожній зміні запису",
        "example": "1",
        "pii": "Ні",
        "default": "1",
        "purpose": "Версія запису для контролю конкурентних змін"
      }
    ]
  },
