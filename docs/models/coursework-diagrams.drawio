и" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;strokeColor=none;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="720" height="45" as="geometry" /></mxCell><mxCell id="l0" value="Логін" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="190" height="50" as="geometry" /></mxCell><mxCell id="f0" value="Навчальний заявник" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="240" y="185" width="500" height="60" as="geometry" /></mxCell><mxCell id="l1" value="Пароль" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="190" height="50" as="geometry" /></mxCell><mxCell id="f1" value="••••••••••••••••" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="240" y="270" width="500" height="60" as="geometry" /></mxCell><mxCell id="b0" value="Увійти" style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;rounded=1;fillColor=#f2f2f2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="320" height="50" as="geometry" /></mxCell><mxCell id="notice" value="Помилка: не вдалося ввійти. Перевірте дані або повторіть пізніше." style="whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=14;fontColor=#111111;strokeColor=#555555;fillColor=#ffffff;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="580" wid